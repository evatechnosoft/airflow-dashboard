{
  "name": "apiflow-monitor-mvp",
  "version": "0.1.0",
  "private": true,
  "description": "Quick MVP dashboard to monitor any API as cards and logs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:generate:pg": "drizzle-kit generate --config drizzle.config.pg.js",
    "db:push:pg": "drizzle-kit push --config drizzle.config.pg.js",
    "dev": "nodemon server.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "nodemon": "^3.1.14"
  }
}
